# Copy to .env for local runs. On Vercel these are project environment variables.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vin
JWT_SECRET=change-me
OTP_SECRET=change-me
# Shared by the website, the Python rescore function and Vercel Cron.
CRON_SECRET=change-me
# Comma-separated emails that can check leases and ownership proofs.
ADMIN_EMAILS=
# Email for sign-in codes: Brevo, or SMTP.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Vision In Neighborhoods
# Local only: shows the sign-in code in the API reply instead of emailing it.
EXPOSE_OTP_IN_RESPONSE=false
# Set to false to skip the 8 sample houses.
SEED_SAMPLES=true
